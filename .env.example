# Public URLs used for links across the site. The defaults are the live
# Vercel deployments, so these only need setting for a custom domain.
VITE_SITE_URL=https://nexlm-landing.vercel.app
VITE_APP_URL=https://nexlm-client.vercel.app
VITE_DOCS_URL=https://nexlm-docs.vercel.app

# Optional: endpoint that accepts POST { email, role } for the waitlist.
# When empty, the form falls back to opening an email to the team.
VITE_WAITLIST_ENDPOINT=
